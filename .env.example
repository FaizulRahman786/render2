# ==================== ENVIRONMENT CONFIGURATION ====================
NODE_VERSION=20
NODE_ENV=production
PORT=3001
BACKEND_PORT=3001
# Production CORS origin - replace with your actual domain
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# ==================== INTERNAL AUTH SECRETS ====================
# Generate strong secrets: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_SECRET
SESSION_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_EXPIRES_IN=7d

# Custom page preview token signing (required for admin custom page preview)
# Generate: openssl rand -hex 32
CUSTOM_PAGE_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET

# Sentry error tracking (optional but recommended)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_APP_VERSION=1.0.0

# ==================== FRONTEND BINDINGS ====================
# Production API URL - replace with your actual API domain
VITE_API_URL=https://api.yourdomain.com/api
# Must be false in production - mock auth bypasses all real security
VITE_ENABLE_AUTH_MOCK=false
# Backend: allow degraded-mode authentication when DATABASE_URL is not yet configured.
# Must be explicitly 'true'. NEVER set to true in production.
ENABLE_AUTH_MOCK=false


# ==================== SUPABASE AUTH INTEGRATION ====================
AUTH_PROVIDER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Supabase Admin (service role) key — BACKEND ONLY. NEVER expose to the frontend.
# Used exclusively by the account-provisioning service (admin.createUser).
# Obtain from Supabase Dashboard → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==================== PLATFORM ADMIN (bootstrap-admin.mjs) ====================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_UID=your-admin-uid-from-supabase
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ==================== SUPABASE DATABASE — RUNTIME (Transaction Pooler) ====================
# Port 6543 — used by Express at runtime via postgres.js (supports PgBouncer / serverless)
# Get from: Supabase Dashboard → Project Settings → Database → Connection Pooling → Transaction mode
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ==================== SUPABASE DATABASE — MIGRATIONS (Direct Connection) ====================
# Port 5432 — used ONLY by drizzle-kit (pnpm db:generate / pnpm db:push)
# Get from: Supabase Dashboard → Project Settings → Database → Connection string → URI
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ==================== CLOUDINARY INTEGRATION ====================
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# ==================== SITEMAP / SEO ====================
# Required for sitemap.xml generation - replace with your production domain
VITE_SITE_URL=https://yourdomain.com
SITE_URL=https://yourdomain.com