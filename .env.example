PORT=3001
BACKEND_PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000

# ── JWT / Session (kept for legacy references, not used for auth) ─────────────
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
SESSION_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api
# Set to "true" ONLY in development when you want to test the UI without a real
# Supabase project (no Google OAuth credentials, no Supabase SMTP, etc.).
# Produces mock tokens that are intercepted on the backend.
# MUST be "false" or unset in production — mock auth bypasses all real security.
VITE_ENABLE_AUTH_MOCK=false

# ── Supabase Auth ─────────────────────────────────────────────────────────────
AUTH_PROVIDER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Supabase Database — RUNTIME (Transaction Pooler) ─────────────────────────
# Port 6543 — used by Express backend at runtime via postgres.js
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Supabase Database — MIGRATIONS (Direct Connection) ───────────────────────
# Port 5432 — used ONLY by drizzle-kit and Supabase CLI for schema migrations
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ── Optional integrations ─────────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
