# Security headers for static hosting (CSP layer — Phase N).
# Vercel also gets these via vercel.json headers (authoritative when deployed there).

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https:; frame-src 'self' https://coaching-backend-kovt.onrender.com http://localhost:3001 http://localhost:5000 http://127.0.0.1:3001 http://127.0.0.1:5000; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
